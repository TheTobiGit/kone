{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "../../packages/agent-core/src/**",
        "../../packages/git-core/src/**"
      ],
      "outputs": ["dist/**", ".nuxt/**", ".output/**", "resources/**"]
    },
    "package": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["release/**"]
    },
    "install:local": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/agent-core/src/**",
        "../../packages/git-core/src/**"
      ]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/agent-core/src/**",
        "../../packages/git-core/src/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
