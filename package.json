{
  "name": "kone",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6",
      "@types/node": "^22.13.14"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:desktop": "turbo run dev -F desktop",
    "build:desktop": "turbo run build -F desktop",
    "package:desktop": "turbo run package -F desktop"
  },
  "devDependencies": {
    "@kone/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
