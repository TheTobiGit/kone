{
  "name": "kone",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6",
      "@types/node": "^22.13.14"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint --report-unused-disable-directives",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "dev:web": "turbo run dev -F web",
    "dev:desktop": "turbo run dev -F desktop",
    "build:desktop": "turbo run build -F desktop",
    "package:desktop": "turbo run package -F desktop",
    "install:desktop": "turbo run install:local -F desktop"
  },
  "devDependencies": {
    "@kone/config": "workspace:*",
    "@nuxt/fonts": "^0.14.0",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "catalog:",
    "oxlint": "1.79.0",
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "web": "workspace:*"
  },
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "cuelume": "^0.2.2"
  }
}
