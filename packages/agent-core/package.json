    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kone/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "catalog:"
  },
  "scripts": {
    "test": "bun test",
    "check-types": "tsc --noEmit"
  }
}
